code/data/
webapp/backend/*.joblib
webapp/backend/*.cbm

# --- Deck watcher process/state files (local run state, not source) ---
code/.deck_watch_state.json
code/.deck_auto_updated.flag

# --- Working-notes scratch folder from cleanup passes ---
_to_delete/
_to_delete_*/

# --- Slide deck build/temp artifacts, if any get generated alongside the real one ---
~$*.pptx
*.pptx.tmp
